# Required now (provided by the Vercel-managed Neon integration)
DATABASE_URL=postgresql://user:password@host:5432/pikko

# Neon Auth (NEON_AUTH_BASE_URL is provisioned by the Neon integration)
NEON_AUTH_BASE_URL=https://your-project.auth.neon.tech
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Comma-separated identities promoted to Pikko platform admin on sign-in
PIKKO_PLATFORM_ADMIN_EMAILS=eddie@dxform.ph

# Required only when the related feature is implemented
# Private Vercel Blob store for manual-payment screenshots
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# APP_URL=http://localhost:3000
# MAYA_ENVIRONMENT=sandbox
# MAYA_PUBLIC_KEY=
# MAYA_SECRET_KEY=
# MAYA_WEBHOOK_SECRET=
# RESEND_API_KEY=re_...
# EMAIL_FROM=Pikko.ph <bookings@pikko.ph>
# Keep false until the sender domain is verified
BOOKING_EMAIL_ENABLED=false

# Local preview seed safety switch (never enable in Production)
# ALLOW_DATABASE_SEED=true
